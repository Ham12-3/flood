# Copy to .env and fill in. Never commit .env.

# --- Frontend (web/) -------------------------------------------------------
# Free token from https://ion.cesium.com/tokens (World Terrain + imagery).
# Without it the globe falls back to the offline Natural Earth image and flat terrain.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# Where the browser finds the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Backend (api/) ---------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
FLOODSCOPE_CORS_ORIGINS=http://localhost:3000
# Optional: where tile/response caches live (default api/.cache).
# FLOODSCOPE_CACHE_DIR=
# Optional: identify yourself to upstream APIs.
# FLOODSCOPE_USER_AGENT=FloodScope3D/0.1 (you@example.com)

# --- AI (Phase 4) -------------------------------------------------------------
# Claude explainer (POST /api/explain). Off while unset.
ANTHROPIC_API_KEY=
# Model for the explainer; the brief's default.
FLOODSCOPE_CLAUDE_MODEL=claude-sonnet-5-5
# Trained forecast model folder (forecast_lstm.onnx + .json from ml/notebooks/train_colab.ipynb).
# FLOODSCOPE_MODEL_DIR=ml/artifacts
# Prithvi satellite water maps (from ml/notebooks/satellite_prithvi.ipynb).
# FLOODSCOPE_SATELLITE_DIR=ml/satellite_results
# Google Flood Forecasting API key (waitlist). The feature is off while unset.
FLOODSCOPE_GOOGLE_FLOOD_API_KEY=
