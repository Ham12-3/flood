# Copy to .env and fill in. Never commit .env.

# --- Frontend (web/) -------------------------------------------------------
# Free token from https://ion.cesium.com/tokens (World Terrain + imagery).
# Without it the globe falls back to the offline Natural Earth image and flat terrain.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# Where the browser finds the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Backend (api/) ---------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
FLOODSCOPE_CORS_ORIGINS=http://localhost:3000
# Optional: where tile/response caches live (default api/.cache).
# FLOODSCOPE_CACHE_DIR=
# Optional: identify yourself to upstream APIs.
# FLOODSCOPE_USER_AGENT=FloodScope3D/0.1 (you@example.com)
