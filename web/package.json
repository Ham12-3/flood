{
  "name": "floodscope-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "cd ../api && uv run python scripts/export_openapi.py ../web/src/lib/openapi.json && cd ../web && openapi-typescript src/lib/openapi.json -o src/lib/api-types.ts",
    "postinstall": "node scripts/copy-cesium.mjs"
  },
  "dependencies": {
    "@next/env": "^16.4.2",
    "cesium": "^1.146.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@webgpu/types": "^0.1.74",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
